{
  "name": "review-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts --dev\" \"vite\"",
    "dev:demo": "REVIEW_DESK_MODE=demo concurrently -k -n api,web \"tsx watch server/index.ts --dev\" \"vite\"",
    "build": "pnpm typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "demo": "pnpm build && REVIEW_DESK_MODE=demo node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm build && playwright test",
    "e2e:update": "pnpm build && playwright test --update-snapshots",
    "format": "prettier --write src server shared tests *.json *.ts index.html README.md",
    "format:check": "prettier --check src server shared tests *.json *.ts index.html README.md"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.26",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fastify": "^5.6.0",
    "lucide-react": "^1.69.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.18.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tinykeys": "^4.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "graphql": "^16.15.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
