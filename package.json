{
  "name": "review-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter @review-desk/shared build && concurrently -k -n shared,api,web \"pnpm --filter @review-desk/shared dev\" \"pnpm --filter @review-desk/server dev\" \"pnpm --filter @review-desk/web dev\"",
    "dev:demo": "REVIEW_DESK_MODE=demo pnpm dev",
    "build": "pnpm typecheck && pnpm -r build",
    "start": "pnpm --filter @review-desk/server start",
    "demo": "pnpm build && REVIEW_DESK_MODE=demo pnpm start",
    "typecheck": "pnpm --filter @review-desk/shared build && pnpm -r typecheck && tsc --noEmit",
    "test": "pnpm --filter @review-desk/shared build && vitest run",
    "test:watch": "pnpm --filter @review-desk/shared build && concurrently -k -n shared,tests \"pnpm --filter @review-desk/shared dev\" \"vitest\"",
    "e2e": "pnpm build && playwright test",
    "e2e:update": "pnpm build && playwright test --update-snapshots",
    "format": "prettier --write apps packages tests *.json *.ts *.yaml README.md",
    "format:check": "prettier --check apps packages tests *.json *.ts *.yaml README.md",
    "db:generate": "pnpm --filter @review-desk/server db:generate",
    "db:check": "pnpm --filter @review-desk/server db:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@review-desk/shared": "workspace:*",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "drizzle-orm": "1.0.0-rc.5",
    "graphql": "^16.15.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tar": "^7.5.22",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
