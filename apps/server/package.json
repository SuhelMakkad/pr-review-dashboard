{
  "name": "@review-desk/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts --dev",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "test": "pnpm --filter @review-desk/shared build && vitest run --root ../.. --config vitest.config.ts --project server"
  },
  "dependencies": {
    "@review-desk/shared": "workspace:*",
    "@fastify/static": "^8.3.0",
    "diff": "^8.0.4",
    "drizzle-orm": "1.0.0-rc.5",
    "fastify": "^5.6.0",
    "tar": "^7.5.22",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "drizzle-kit": "1.0.0-rc.5",
    "graphql": "^16.15.0",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
