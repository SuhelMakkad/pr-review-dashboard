{
  "name": "@review-desk/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "concurrently -k \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"tsc-alias -p tsconfig.build.json --watch\"",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @review-desk/shared build && vitest run --root ../.. --config vitest.config.ts --project shared"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "tsc-alias": "^1.9.10",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
